# The default OpenRouter API key to be used for public visitors
OPENROUTER_API_KEY=your_openrouter_api_key_here

# The Master Code to bypass public limits
MASTER_CODE=your_secret_master_code_here

# The default model to use for OpenRouter
DEFAULT_OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free
